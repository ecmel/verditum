{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Verditum",
  "version": "0.1.0",
  "identifier": "dev.ecmel.verditum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Verditum",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "Ecmel Ercan",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [{ "ext": ["udf"] }]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxMTVFMDlGRjRFMzIyN0UKUldSK0l1UDBuK0FWNFpMUzQrTUtCbmJrUExXNC9mTTVZc0IycVl4bTJ5UzQzSkU0L1JCVkRQWXkK",
      "endpoints": [
        "https://github.com/ecmel/verditum/releases/latest/download/latest.json"
      ]
    }
  }
}
